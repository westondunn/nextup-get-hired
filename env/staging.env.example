# Template for .env.staging (Nextup OSS staging), or the key list for the Portainer stack
# variables. The launcher never creates this file: copy it, fill it in, and chmod 600.
# Only NEXTUP_STG_* keys are accepted, and none of them is a secret. Never put a password,
# token or key here or in Portainer: stack variables are stored and displayed by Portainer.
# Live job fetches and Google sync are disabled in staging and cannot be enabled from here.

# Required. A new UUID4 for this staging instance (python3 -c 'import uuid; print(uuid.uuid4())').
NEXTUP_STG_INSTANCE_ID=
# Required. Absolute host directory with the operator-generated secret files
# db_admin_password, db_owner_password, db_app_password, migration_key and setup_code
# (directory root-owned 0750; files root-owned 0440; 24-256 URL-safe characters each,
# newly generated for staging and never copied from any other system).
NEXTUP_STG_SECRETS_DIR=
# Required. Numeric group of those files; the backend containers join it to read them.
NEXTUP_STG_SECRETS_GID=

# Loopback-only host ports, distinct from every other stack on the same engine.
NEXTUP_STG_API_PORT=28000
NEXTUP_STG_FRONTEND_PORT=25173

NEXTUP_STG_DIAGNOSTIC_INTERVAL_SECONDS=60
NEXTUP_STG_JOB_FETCH_MIN_INTERVAL_SECONDS=60
NEXTUP_STG_JOB_RETENTION_DAYS=30
NEXTUP_STG_TASK_HISTORY_CLEANUP_ENABLED=false
NEXTUP_STG_TASK_HISTORY_RETENTION_DAYS=30
NEXTUP_STG_TASK_HISTORY_BATCH_SIZE=100
