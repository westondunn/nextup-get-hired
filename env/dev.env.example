# Template for .env.dev (Nextup OSS local development). Do not copy values from any
# other stack. `python3 scripts/local.py --env dev start` creates .env.dev from this
# template (mode 0600), filling in a new instance ID and your UID/GID.
# Only NEXTUP_DEV_* keys are accepted; anything else makes the launcher refuse.
# This file never holds a secret: database passwords and the migration key are separate
# files under .secrets/dev/ that the launcher generates (directory 0700, files 0600).

# Required. Left empty here on purpose; the launcher fills them in .env.dev only.
NEXTUP_DEV_INSTANCE_ID=
NEXTUP_DEV_LOCAL_UID=
NEXTUP_DEV_LOCAL_GID=

# Loopback-only host ports. Must not reuse ports of any other stack.
NEXTUP_DEV_API_PORT=18000
NEXTUP_DEV_FRONTEND_PORT=15173

NEXTUP_DEV_DIAGNOSTIC_INTERVAL_SECONDS=60
NEXTUP_DEV_JOB_FETCH_MIN_INTERVAL_SECONDS=60
NEXTUP_DEV_JOB_RETENTION_DAYS=30
NEXTUP_DEV_TASK_HISTORY_CLEANUP_ENABLED=false
NEXTUP_DEV_TASK_HISTORY_RETENTION_DAYS=30
NEXTUP_DEV_TASK_HISTORY_BATCH_SIZE=100
