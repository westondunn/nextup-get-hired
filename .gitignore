# Ignore rules keep local files out of commits. They are not a privacy or secret
# control: review what you stage before every commit.

# Environment files and secrets
.env
.env.*
!.env.example
.secrets/
*.pem
*.key
*.p12
*.pfx
client_secret*.json
credentials*.json

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Node
node_modules/
dist/
*.tsbuildinfo
.eslintcache

# Test output
coverage/
test-results/
playwright-report/
.playwright/

# Runtime
*.log
celerybeat-schedule*
backups/
*.dump
*.pgdump
*.sql.gz

# OS and editor leftovers
.DS_Store
Thumbs.db
*.swp
*~
*.bak
*.orig
*.tmp

# Local data, private documents and scratch space (never committed)
/data/
/private/
/docs/private/
/tmp/
/scratch/
/evidence/

# Editor settings: only the shared project files are tracked
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
*.code-workspace
.idea/

# Personal agent and tool configuration
.claude/
.cursor/
.mcp.json
CLAUDE.local.md

# Local overrides
*.local.json
*.local.yaml
*.local.yml
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml
